{
  "name": "knead",
  "version": "3",
  "description": "Playsound generator for Minecraft",
  "author": "NeAc",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "cross-env NODE_ENV=\"development\" webpack serve --config webpack.config.ts --mode development",
    "build": "cross-env NODE_ENV=\"production\" webpack --progress",
    "package": "tauri build",
    "package:win": "tauri build --bundles nsis",
    "package:mac": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage",
    "tauri": "tauri",
    "tcm": "tcm src",
    "lint": "eslint src/** --no-error-on-unmatched-pattern --fix",
    "selfcheck": "npx ts-node -e \"require('./src/web/Sub/utils/tickPixel')._selfCheckTickPixel(); require('./src/web/Sub/utils/timelineIO')._selfCheckTimelineIO(); require('./src/web/Sub/utils/curvePresets')._selfCheckCurvePresets(); require('./src/web/Sub/utils/curveScaling')._selfCheckCurveScaling(); require('./src/web/Sub/utils/curveHandles')._selfCheckCurveHandles(); require('./src/web/Sub/utils/projectFiles')._selfCheckProjectFiles(); require('./src/web/components/virtualSelectDropdowns.selfcheck')._selfCheckVirtualSelectDropdowns()\" && npx ts-node src/web/components/virtualSelectDropdowns.dom.selfcheck.tsx"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@stylistic/eslint-plugin-js": "^2.12.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/webaudioapi": "^0.0.27",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^22.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tauri-apps/api": "^2.0.0",
    "@yamada-ui/lucide": "^1.10.5",
    "@yamada-ui/react": "^2.2.4",
    "i18next": "^24.2.0",
    "immer": "^11.1.11",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.4.0",
    "react-select": "^5.10.1",
    "react-window": "^1.8.11",
    "uuid": "^11.1.0"
  }
}
